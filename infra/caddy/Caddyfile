  a:hover { border-color: #4f9cf9; }
  a .num { color: #4f9cf9; font-weight: 700; font-size: 11px; letter-spacing: .5px; text-transform: uppercase; margin-bottom: 4px; }
  a .name { font-size: 14px; font-weight: 600; }
  a .tag { color: #64748b; font-size: 11px; margin-top: 4px; }
  .coming { opacity: .4; cursor: default; }
  footer { color: #334155; font-size: 12px; margin-top: 40px; }
