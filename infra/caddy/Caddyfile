# =============================================================================
# Caddyfile — System Design Projects reverse proxy
#
# Current mode: HTTP only (no domain yet).
# Each project is accessible at:  http://<VM_IP>:<port>  (direct)
# OR via this proxy at:            http://<VM_IP>/p01, /p02, ...
#
# When you get a domain:
#   1. Point *.yourdomain.com → VM public IP (DNS A record)
#   2. Uncomment the HTTPS blocks below
#   3. Delete the HTTP blocks
#   4. Run: sudo systemctl reload caddy
#   Caddy auto-fetches Let's Encrypt certificates — no certbot needed.
# =============================================================================

# ── Global options ─────────────────────────────────────────────────────────────
{
    # Caddy admin API (local only — used by `caddy reload`)
    admin localhost:2019

    # Uncomment when switching to HTTPS with a real domain:
    # email anksr2018@gmail.com
}

# =============================================================================
# HTTP mode — IP-based routing with path prefixes
# Access projects at: http://<VM_IP>/p01/  http://<VM_IP>/p02/  etc.
# =============================================================================

:80 {
    # ── Health check for Caddy itself ─────────────────────────────────────────
    handle /caddy-health {
        respond "ok" 200
    }

    # ── Project 01 — Rate Limiter (:8081) ─────────────────────────────────────
    handle_path /p01/* {
        reverse_proxy localhost:8081
    }

    # ── Project 02 — URL Shortener (:8085) ────────────────────────────────────
    handle_path /p02/* {
        reverse_proxy localhost:8085
    }

    # ── Project 03 — Pastebin (:8082) ─────────────────────────────────────────
    handle_path /p03/* {
        reverse_proxy localhost:8082
    }

    # ── Project 04 — Unique ID Generator (:8083) ──────────────────────────────
    handle_path /p04/* {
        reverse_proxy localhost:8083
    }

    # ── Project 05 — Consistent Hashing (:8084) ───────────────────────────────
    handle_path /p05/* {
        reverse_proxy localhost:8084
    }

    # ── Project 06 — Load Balancer (:8086) ────────────────────────────────────
    handle_path /p06/* {
        reverse_proxy localhost:8086
    }

    # ── Project 07 — API Gateway (:8088) ──────────────────────────────────────
    handle_path /p07/* {
        reverse_proxy localhost:8088
    }

    # ── Project 08 — Basic Key-Value Store (:8089) ────────────────────────────
    handle_path /p08/* {
        reverse_proxy localhost:8089
    }

    # ── Project 09 — Caching System (:8090) ───────────────────────────────────
    handle_path /p09/* {
        reverse_proxy localhost:8090
    }

    # ── Project 10 — Notification System (:8091) ─────────────────────────────
    handle_path /p10/* {
        reverse_proxy localhost:8091
    }

    # ── Project 11 — Typeahead Autocomplete (:8092) ──────────────────────────
    handle_path /p11/* {
        reverse_proxy localhost:8092
    }

    # ── Project 12 — Web Crawler (:8093) ──────────────────────────────────────
    handle_path /p12/* {
        reverse_proxy localhost:8093
    }

    # Add further projects here as they are built.
    # Template:
    #   handle_path /pNN/* {
    #       reverse_proxy localhost:<actual-port>
    #   }
    # Check infra/ports.md for the correct port before adding.

    # ── Default: index of running projects ────────────────────────────────────
    handle {
        respond `
<!doctype html>
