{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(urlshortener_http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(urlshortener_cache_lookups_total[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "title": "Cache Lookups",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(urlshortener_redirect_duration_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "p95 {{cache}}"
        }
      ],
      "title": "Redirect p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(urlshortener_links_created_total) by (owner_id)",
          "legendFormat": "{{owner_id}}"
        }
      ],
      "title": "Links Created",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
