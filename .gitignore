# Go binaries
*.exe
*.out
/projects/*/dist/
/projects/*/bin/

# Go test cache
*.test

# Go module download cache (not needed in repo)
vendor/

# Java / Gradle build outputs (projects 14+)
**/build/
**/.gradle/
.gradle/

# Scheduled-task lock (local runtime state)
.claude/scheduled_tasks.lock

# Environment files
.env
*.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Docker volumes (local data, not code)
**/data/
# Exception: static web assets bundled into Docker images
!**/web/data/

# Terraform scratch directories
terraform-temp/

# Terraform — never commit state or real credentials
terraform/**/.terraform/
terraform/**/.terraform.lock.hcl
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.backup
terraform/**/terraform.tfvars
terraform/**/*.tfvars
!terraform/**/terraform.tfvars.example
